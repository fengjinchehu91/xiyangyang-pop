# Public, browser-visible settings only. Never put a private key here.
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org

# Public BSC history endpoint with browser CORS and eth_getLogs (5000-block chunks).
VITE_BSC_HISTORY_RPC_URL=https://rpc-bsc.48.club

# Blank values use the source-verified deployed addresses in src/config/verified.ts.
# A treasury override needs its own independently verified floor-price interface.
VITE_TREASURY_ADDRESS=
VITE_BUYBACK_ADDRESS=

# Current buyback reserve asset. Use erc20 or native, only after confirmation.
VITE_BUYBACK_ASSET_KIND=
VITE_BUYBACK_ASSET_ADDRESS=

# IMPORTANT: the default buyback recipient is an EOA. Its entire wallet balance
# has NOT been proven to be project-dedicated available buyback funds.
# Keep false until the scope, ownership and availability have verified evidence.
VITE_BUYBACK_BALANCE_VERIFIED=false
VITE_BUYBACK_BALANCE_EVIDENCE_URL=

# Optional confirmed pool and burn-record URLs; leave blank when unknown.
VITE_TRADING_POOL_ADDRESS=
VITE_BURN_RECORDS_URL=

# Verified view ABI/methods and reliable price adapters:
# src/config/contracts.ts and src/config/quotes.ts.
# The project-requested USD display basis (reserve USD / 30 million) is separately
# configured in src/config/valuation.ts, not substituted for the contract getter.
